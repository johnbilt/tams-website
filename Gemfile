source "https://rubygems.org"

# GitHub Pages — pins Jekyll and all supported plugins to the versions
# GitHub Pages runs, so local builds match production.
# Preview/build for this project happens on GitHub Pages, but this keeps parity
# for anyone who does want to run `bundle exec jekyll serve` locally.
gem "github-pages", group: :jekyll_plugins

# Windows / JRuby timezone data
gem "tzinfo-data", platforms: [:mingw, :mswin, :x64_mingw, :jruby]

# Faster file watching on Windows during local `jekyll serve`
gem "wdm", "~> 0.1.1", platforms: [:mingw, :mswin, :x64_mingw]
